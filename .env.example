# ==============================================================
# KKR Construction & Developers - Email Notification Configuration
# ==============================================================
# Copy these keys into your Vercel Project Settings -> Environment Variables

# Gmail SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Your Gmail address used to send emails
SMTP_USER=kkrconstructiondevelopers@gmail.com

# 16-character Google App Password (Generate from Google Account -> Security -> 2FA -> App Passwords)
SMTP_PASS=your_16_character_app_password_here

# Business Email where all incoming lead notifications will be sent
ADMIN_EMAIL=kkrconstructiondevelopers@gmail.com

# Company Metadata for Email Headers & Signatures
COMPANY_NAME=KKR Construction & Developers
COMPANY_PHONE=+91 80721 83386
COMPANY_EMAIL=kkrconstructiondevelopers@gmail.com
COMPANY_ADDRESS=Plot No:37, Sai Garden, Thiruvallur, Tamil Nadu 631203
COMPANY_WEBSITE=https://kkrconstruction.com
